{
  "title": "Practice mode",
  "body": "Solve the support reactions step by step.",
  "steps": [
    {
      "id": "identify-reactions",
      "title": "Identify support reactions",
      "goal": "Select all unknown support reactions that belong in the free-body diagram.",
      "canvasState": {
        "visibleObjects": [
          "supportA",
          "supportB",
          "angledLoad",
          "pointLoad",
          "dimensionTotal",
          "dimensionAtoLoad"
        ]
      },
      "interaction": {
        "type": "checkbox",
        "options": [
          {
            "id": "reactionAx",
            "label": "A_x",
            "latex": "A_x"
          },
          {
            "id": "reactionAy",
            "label": "A_y",
            "latex": "A_y"
          },
          {
            "id": "momentA",
            "label": "M_A",
            "latex": "M_A"
          },
          {
            "id": "reactionBx",
            "label": "B_x",
            "latex": "B_x"
          },
          {
            "id": "reactionBy",
            "label": "B_y",
            "latex": "B_y"
          },
          {
            "id": "momentB",
            "label": "M_B",
            "latex": "M_B"
          }
        ],
        "correctOptionIds": [
          "reactionAx",
          "reactionAy",
          "reactionBy"
        ]
      },
      "feedback": {
        "correct": "Correct. The pin at A gives A_x and A_y, and the roller at B gives B_y.",
        "genericIncorrect": "Check which motions each support can prevent.",
        "mistakes": [
          {
            "id": "selected:momentA",
            "text": "A pin support cannot transmit a support moment."
          },
          {
            "id": "selected:reactionBx",
            "text": "The roller at B does not create a horizontal reaction."
          },
          {
            "id": "selected:momentB",
            "text": "A roller support cannot transmit a moment."
          },
          {
            "id": "missing:reactionAx",
            "text": "The pin at A can prevent horizontal motion, so A_x is an unknown."
          },
          {
            "id": "missing:reactionAy",
            "text": "The pin at A can prevent vertical motion, so A_y is an unknown."
          },
          {
            "id": "missing:reactionBy",
            "text": "The roller at B creates the vertical reaction B_y."
          }
        ]
      },
      "hints": [
        {
          "level": 1,
          "text": "A pin support has two force components."
        },
        {
          "level": 2,
          "text": "A roller support has one reaction normal to the surface."
        },
        {
          "level": 3,
          "text": "Neither support is fixed, so no support moment appears."
        }
      ],
      "successResult": {
        "revealObjects": [
          "reactionAx",
          "reactionAy",
          "reactionBy"
        ]
      }
    },
    {
      "id": "decompose-force",
      "title": "Decompose the angled force",
      "goal": "Match each force-component idea to the correct expression.",
      "canvasState": {
        "visibleObjects": [
          "reactionAx",
          "reactionAy",
          "reactionBy",
          "componentFx",
          "componentFy",
          "angleAlpha",
          "angledLoad"
        ]
      },
      "interaction": {
        "type": "matching",
        "leftItems": [
          {
            "id": "horizontalComponent",
            "label": "horizontal component",
            "latex": "F_x"
          },
          {
            "id": "verticalMagnitude",
            "label": "vertical component magnitude",
            "latex": "|F_y|"
          },
          {
            "id": "verticalSigned",
            "label": "vertical equilibrium contribution",
            "latex": "F_y"
          }
        ],
        "rightItems": [
          {
            "id": "fCos",
            "label": "F cos(alpha)",
            "latex": "F\\cos(\\alpha)"
          },
          {
            "id": "fSin",
            "label": "F sin(alpha)",
            "latex": "F\\sin(\\alpha)"
          },
          {
            "id": "negativeFSin",
            "label": "-F sin(alpha)",
            "latex": "-F\\sin(\\alpha)"
          }
        ],
        "correctPairs": {
          "horizontalComponent": "fCos",
          "verticalMagnitude": "fSin",
          "verticalSigned": "negativeFSin"
        }
      },
      "feedback": {
        "correct": [
          {
            "type": "paragraph",
            "text": "Correct. The magnitude of the vertical component is positive, but its signed contribution is downward:"
          },
          {
            "type": "math",
            "latex": "F_y = -F\\sin(\\alpha)"
          }
        ],
        "genericIncorrect": "Separate component magnitude from signed contribution in the equilibrium equation.",
        "mistakes": [
          {
            "id": "wrong:horizontalComponent",
            "text": "Because alpha is measured from the x-axis, the horizontal component uses cosine."
          },
          {
            "id": "wrong:verticalMagnitude",
            "text": "The vertical component magnitude is positive."
          },
          {
            "id": "wrong:verticalSigned",
            "text": "The force points downward, so the signed y-contribution is negative."
          }
        ]
      },
      "hints": [
        {
          "level": 1,
          "text": "The adjacent component to alpha uses cosine."
        },
        {
          "level": 2,
          "text": "The vertical component points downward."
        },
        {
          "level": 3,
          "content": [
            {
              "type": "math",
              "latex": "F_x=F\\cos(\\alpha),\\quad F_y=-F\\sin(\\alpha)"
            }
          ]
        }
      ]
    },
    {
      "id": "build-horizontal-equation",
      "title": "Build horizontal force equilibrium",
      "goal": "Choose the terms for horizontal equilibrium.",
      "canvasState": {
        "visibleObjects": [
          "reactionAx",
          "reactionAy",
          "reactionBy",
          "componentFx",
          "componentFy",
          "angleAlpha"
        ]
      },
      "interaction": {
        "type": "equation-builder",
        "equationTarget": "sumFx",
        "availableTerms": [
          {
            "id": "axPositive",
            "latex": "+ A_x",
            "semantic": {
              "variable": "A_x",
              "direction": "x",
              "sign": "+"
            }
          },
          {
            "id": "axNegative",
            "latex": "- A_x",
            "semantic": {
              "variable": "A_x",
              "direction": "x",
              "sign": "-"
            }
          },
          {
            "id": "fCosPositive",
            "latex": "+ F\\cos(\\alpha)",
            "semantic": {
              "variable": "F",
              "direction": "x",
              "sign": "+",
              "factor": "cos(alpha)",
              "componentId": "angledLoadFx"
            }
          },
          {
            "id": "fCosNegative",
            "latex": "- F\\cos(\\alpha)",
            "semantic": {
              "variable": "F",
              "direction": "x",
              "sign": "-",
              "factor": "cos(alpha)",
              "componentId": "angledLoadFx"
            }
          },
          {
            "id": "fSinNegative",
            "latex": "- F\\sin(\\alpha)",
            "semantic": {
              "variable": "F",
              "direction": "y",
              "sign": "-",
              "factor": "sin(alpha)",
              "componentId": "angledLoadFy"
            }
          }
        ],
        "expectedEquation": {
          "equationType": "sumFx",
          "terms": [
            {
              "variable": "A_x",
              "sign": "+"
            },
            {
              "variable": "F",
              "sign": "+",
              "factor": "cos(alpha)",
              "componentId": "angledLoadFx"
            }
          ],
          "rhs": "0"
        }
      },
      "feedback": {
        "correct": [
          {
            "type": "paragraph",
            "text": "Correct. Horizontal equilibrium gives:"
          },
          {
            "type": "math",
            "latex": "A_x + F\\cos(\\alpha) = 0"
          },
          {
            "type": "math",
            "latex": "A_x = -F\\cos(\\alpha)"
          },
          {
            "type": "paragraph",
            "text": "The negative sign means the actual support force acts opposite to the assumed positive arrow direction."
          }
        ],
        "genericIncorrect": "Only x-direction terms belong in horizontal force equilibrium.",
        "mistakes": [
          {
            "id": "wrongSign:F",
            "text": "The horizontal component points to the right, so it is positive."
          },
          {
            "id": "wrongSign:A_x",
            "text": "Use A_x as an unknown term with a positive assumed direction."
          },
          {
            "id": "extra:F",
            "text": "Use the horizontal component, not the vertical component."
          },
          {
            "id": "missing:A_x:+:",
            "text": "A_x must be included in horizontal equilibrium."
          },
          {
            "id": "missing:F:+:cos(alpha)",
            "text": "The horizontal component is F cos(alpha)."
          }
        ]
      },
      "hints": [
        {
          "level": 1,
          "text": "The roller at B has no horizontal reaction."
        },
        {
          "level": 2,
          "content": [
            {
              "type": "math",
              "latex": "\\sum F_x = A_x + F\\cos(\\alpha)"
            }
          ]
        },
        {
          "level": 3,
          "content": [
            {
              "type": "math",
              "latex": "A_x = -F\\cos(\\alpha)"
            }
          ]
        }
      ],
      "successResult": {
        "revealObjects": [
          "reactionAx"
        ]
      }
    },
    {
      "id": "choose-moment-point",
      "title": "Choose a moment point",
      "goal": "Click the point in the canvas that makes the moment equation solve B_y directly.",
      "instructions": "Use the canvas selection marker, then check your choice.",
      "canvasState": {
        "visibleObjects": [
          "reactionAx",
          "reactionAy",
          "reactionBy",
          "componentFx",
          "componentFy",
          "pointLoad"
        ]
      },
      "interaction": {
        "type": "canvas-click",
        "selectableIds": [
          "pointA",
          "pointLoad",
          "pointB"
        ],
        "correctSelectableIds": [
          "pointA"
        ],
        "labels": [
          {
            "id": "pointA",
            "label": "A"
          },
          {
            "id": "pointLoad",
            "label": "load point"
          },
          {
            "id": "pointB",
            "label": "B"
          }
        ]
      },
      "feedback": {
        "correct": "Correct. Around A, A_x and A_y have zero lever arm, so the equation solves B_y directly.",
        "genericIncorrect": "Choose a point that removes as many unknown reactions as possible from the moment equation.",
        "mistakes": [
          {
            "id": "selected:pointLoad",
            "text": "The load point removes the load, but both support reactions remain."
          },
          {
            "id": "selected:pointB",
            "text": "Point B is possible, but it solves A_y first. Point A solves B_y directly."
          },
          {
            "id": "missing:pointA",
            "text": "Use point A so the reactions at A have zero lever arm."
          }
        ]
      },
      "hints": [
        {
          "level": 1,
          "text": "A force through the moment point creates no moment."
        },
        {
          "level": 2,
          "text": "Taking moments about A removes both A_x and A_y."
        },
        {
          "level": 3,
          "text": "With moments about A, only the vertical load component and B_y remain."
        }
      ]
    },
    {
      "id": "match-lever-arms",
      "title": "Identify lever arms around A",
      "goal": "Match each force or component to its perpendicular lever arm about point A.",
      "canvasState": {
        "visibleObjects": [
          "reactionAx",
          "reactionAy",
          "reactionBy",
          "componentFx",
          "componentFy",
          "dimensionAtoLoad",
          "dimensionTotal"
        ]
      },
      "interaction": {
        "type": "matching",
        "leftItems": [
          {
            "id": "reactionAx",
            "label": "A_x",
            "latex": "A_x"
          },
          {
            "id": "reactionAy",
            "label": "A_y",
            "latex": "A_y"
          },
          {
            "id": "componentFx",
            "label": "F cos(alpha)",
            "latex": "F\\cos(\\alpha)"
          },
          {
            "id": "componentFy",
            "label": "F sin(alpha)",
            "latex": "F\\sin(\\alpha)"
          },
          {
            "id": "reactionBy",
            "label": "B_y",
            "latex": "B_y"
          }
        ],
        "rightItems": [
          {
            "id": "zero",
            "label": "0",
            "latex": "0"
          },
          {
            "id": "a",
            "label": "a",
            "latex": "a"
          },
          {
            "id": "length",
            "label": "L",
            "latex": "L"
          }
        ],
        "correctPairs": {
          "reactionAx": "zero",
          "reactionAy": "zero",
          "componentFx": "zero",
          "componentFy": "a",
          "reactionBy": "length"
        }
      },
      "feedback": {
        "correct": "Correct. The horizontal component lies on the beam axis, so it has zero moment arm about A in this drawing model.",
        "genericIncorrect": "Measure perpendicular distance from A to each line of action.",
        "mistakes": [
          {
            "id": "wrong:componentFx",
            "text": "The force is applied on the beam centerline, so F cos(alpha) has no moment about A."
          },
          {
            "id": "wrong:componentFy",
            "text": "The vertical component acts at distance a from A."
          },
          {
            "id": "wrong:reactionBy",
            "text": "B_y acts at B, one full span L from A."
          }
        ]
      },
      "hints": [
        {
          "level": 1,
          "text": "Forces applied at A have zero lever arm."
        },
        {
          "level": 2,
          "text": "The horizontal component acts along the beam axis."
        },
        {
          "level": 3,
          "content": [
            {
              "type": "math",
              "latex": "r_{F\\sin(\\alpha)}=a,\\quad r_{B_y}=L"
            }
          ]
        }
      ]
    },
    {
      "id": "determine-moment-signs",
      "title": "Determine moment signs",
      "goal": "Use counterclockwise positive and match each moment term to its sign.",
      "canvasState": {
        "visibleObjects": [
          "reactionAx",
          "reactionAy",
          "reactionBy",
          "componentFx",
          "componentFy"
        ]
      },
      "interaction": {
        "type": "matching",
        "leftItems": [
          {
            "id": "termByL",
            "label": "B_y · L",
            "latex": "B_y\\cdot L"
          },
          {
            "id": "termFSinA",
            "label": "F sin(alpha) · a",
            "latex": "F\\sin(\\alpha)\\cdot a"
          }
        ],
        "rightItems": [
          {
            "id": "positive",
            "label": "+",
            "latex": "+"
          },
          {
            "id": "negative",
            "label": "-",
            "latex": "-"
          }
        ],
        "correctPairs": {
          "termByL": "positive",
          "termFSinA": "negative"
        }
      },
      "feedback": {
        "correct": "Correct. B_y rotates counterclockwise about A, while the downward component rotates clockwise.",
        "genericIncorrect": "Apply the sign convention: counterclockwise moments are positive.",
        "mistakes": [
          {
            "id": "wrong:termByL",
            "text": "B_y at B rotates counterclockwise around A."
          },
          {
            "id": "wrong:termFSinA",
            "text": "The downward vertical component rotates clockwise around A."
          }
        ]
      },
      "hints": [
        {
          "level": 1,
          "text": "Imagine the beam rotating about A."
        },
        {
          "level": 2,
          "text": "An upward force at B lifts the right end."
        },
        {
          "level": 3,
          "text": "A downward force at the load point pushes the right side down."
        }
      ]
    },
    {
      "id": "build-moment-equation",
      "title": "Build the moment equation",
      "goal": "Choose the terms for moment equilibrium about A.",
      "canvasState": {
        "visibleObjects": [
          "reactionAx",
          "reactionAy",
          "reactionBy",
          "componentFx",
          "componentFy",
          "dimensionAtoLoad",
          "dimensionTotal"
        ]
      },
      "interaction": {
        "type": "equation-builder",
        "equationTarget": "sumMoment",
        "aboutPoint": "A",
        "availableTerms": [
          {
            "id": "byLPositive",
            "latex": "+ B_y\\cdot L",
            "semantic": {
              "variable": "B_y",
              "sign": "+",
              "factor": "L",
              "momentAbout": "A"
            }
          },
          {
            "id": "byLNegative",
            "latex": "- B_y\\cdot L",
            "semantic": {
              "variable": "B_y",
              "sign": "-",
              "factor": "L",
              "momentAbout": "A"
            }
          },
          {
            "id": "fSinAPositive",
            "latex": "+ F\\sin(\\alpha)\\cdot a",
            "semantic": {
              "variable": "F",
              "sign": "+",
              "factor": "sin(alpha)*a",
              "componentId": "angledLoadFy",
              "momentAbout": "A"
            }
          },
          {
            "id": "fSinANegative",
            "latex": "- F\\sin(\\alpha)\\cdot a",
            "semantic": {
              "variable": "F",
              "sign": "-",
              "factor": "sin(alpha)*a",
              "componentId": "angledLoadFy",
              "momentAbout": "A"
            }
          },
          {
            "id": "fCosAZero",
            "latex": "+ F\\cos(\\alpha)\\cdot 0",
            "semantic": {
              "variable": "F_x",
              "sign": "+",
              "factor": "0",
              "componentId": "angledLoadFx",
              "momentAbout": "A"
            }
          },
          {
            "id": "ayZero",
            "latex": "+ A_y\\cdot 0",
            "semantic": {
              "variable": "A_y",
              "sign": "+",
              "factor": "0",
              "momentAbout": "A"
            }
          },
          {
            "id": "axZero",
            "latex": "+ A_x\\cdot 0",
            "semantic": {
              "variable": "A_x",
              "sign": "+",
              "factor": "0",
              "momentAbout": "A"
            }
          }
        ],
        "expectedEquation": {
          "equationType": "sumMoment",
          "aboutPoint": "A",
          "terms": [
            {
              "variable": "B_y",
              "sign": "+",
              "factor": "L"
            },
            {
              "variable": "F",
              "sign": "-",
              "factor": "sin(alpha)*a",
              "componentId": "angledLoadFy"
            }
          ],
          "rhs": "0"
        }
      },
      "feedback": {
        "correct": [
          {
            "type": "paragraph",
            "text": "Correct. The moment equation is:"
          },
          {
            "type": "math",
            "latex": "B_y\\cdot L - F\\sin(\\alpha)\\cdot a = 0"
          }
        ],
        "genericIncorrect": "Keep only nonzero moment terms about A, with signs from the chosen convention.",
        "mistakes": [
          {
            "id": "wrongSign:F",
            "text": "The vertical load component rotates clockwise about A, so it is negative."
          },
          {
            "id": "wrongSign:B_y",
            "text": "B_y rotates counterclockwise about A, so it is positive."
          },
          {
            "id": "wrongFactor:F",
            "text": "Use the vertical component and the lever arm a."
          },
          {
            "id": "zeroTerm:A_y",
            "text": "A_y acts at A, so its lever arm is zero."
          },
          {
            "id": "zeroTerm:A_x",
            "text": "A_x acts at A, so its lever arm is zero."
          },
          {
            "id": "zeroTerm:F_x",
            "text": "The horizontal component lies along the beam axis, so it has zero moment about A."
          }
        ]
      },
      "hints": [
        {
          "level": 1,
          "text": "Only the vertical load component and B_y have nonzero moments about A."
        },
        {
          "level": 2,
          "text": "B_y is positive and the load component is negative."
        },
        {
          "level": 3,
          "content": [
            {
              "type": "math",
              "latex": "B_y\\cdot L - F\\sin(\\alpha)\\cdot a = 0"
            }
          ]
        }
      ]
    },
    {
      "id": "solve-by",
      "title": "Solve for B_y",
      "goal": [
        {
          "type": "paragraph",
          "text": "Solve the moment equation for $B_y$."
        }
      ],
      "instructions": [
        {
          "type": "math",
          "latex": "B_y\\cdot L - F\\sin(\\alpha)\\cdot a = 0"
        }
      ],
      "canvasState": {
        "visibleObjects": [
          "reactionAx",
          "reactionAy",
          "reactionBy",
          "componentFx",
          "componentFy"
        ]
      },
      "interaction": {
        "type": "expression-input",
        "variable": "B_y",
        "expectedExpression": "F*sin(alpha)*a/L",
        "acceptedExpressions": [
          "F sin(alpha) a / L",
          "F*a*sin(alpha)/L",
          "(F sin(alpha) a) / L",
          "B_y = F*sin(alpha)*a/L"
        ]
      },
      "feedback": {
        "correct": "Correct. B_y is the vertical component times its load position divided by the span.",
        "genericIncorrect": [
          {
            "type": "paragraph",
            "text": "Start from:"
          },
          {
            "type": "math",
            "latex": "B_y\\cdot L = F\\sin(\\alpha)\\cdot a"
          },
          {
            "type": "paragraph",
            "text": "Then divide by L."
          }
        ],
        "mistakes": [
          {
            "id": "negativeExpression",
            "text": "A negative B_y means one moment sign was reversed."
          },
          {
            "id": "expressionIncorrect",
            "text": "Keep the vertical component F sin(alpha), the lever arm a, and divide by L."
          }
        ]
      },
      "hints": [
        {
          "level": 1,
          "content": [
            {
              "type": "math",
              "latex": "B_y\\cdot L = F\\sin(\\alpha)\\cdot a"
            }
          ]
        },
        {
          "level": 2,
          "text": "Divide the whole equation by L."
        },
        {
          "level": 3,
          "content": [
            {
              "type": "math",
              "latex": "B_y=\\frac{F\\sin(\\alpha)a}{L}"
            }
          ]
        }
      ],
      "successResult": {
        "revealObjects": [
          "reactionBy"
        ]
      }
    },
    {
      "id": "build-vertical-equation",
      "title": "Build vertical force equilibrium",
      "goal": "Choose the terms for vertical force equilibrium.",
      "canvasState": {
        "visibleObjects": [
          "reactionAx",
          "reactionAy",
          "reactionBy",
          "componentFx",
          "componentFy"
        ]
      },
      "interaction": {
        "type": "equation-builder",
        "equationTarget": "sumFy",
        "availableTerms": [
          {
            "id": "ayPositive",
            "latex": "+ A_y",
            "semantic": {
              "variable": "A_y",
              "direction": "y",
              "sign": "+"
            }
          },
          {
            "id": "byPositive",
            "latex": "+ B_y",
            "semantic": {
              "variable": "B_y",
              "direction": "y",
              "sign": "+"
            }
          },
          {
            "id": "fSinPositive",
            "latex": "+ F\\sin(\\alpha)",
            "semantic": {
              "variable": "F",
              "direction": "y",
              "sign": "+",
              "factor": "sin(alpha)",
              "componentId": "angledLoadFy"
            }
          },
          {
            "id": "fSinNegative",
            "latex": "- F\\sin(\\alpha)",
            "semantic": {
              "variable": "F",
              "direction": "y",
              "sign": "-",
              "factor": "sin(alpha)",
              "componentId": "angledLoadFy"
            }
          },
          {
            "id": "fCosPositive",
            "latex": "+ F\\cos(\\alpha)",
            "semantic": {
              "variable": "F",
              "direction": "x",

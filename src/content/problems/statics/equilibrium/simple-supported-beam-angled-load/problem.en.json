    }
  },
  "explore": {
    "noticeTitle": "What to notice",
    "notices": [
      "The angled force must be decomposed before equilibrium equations are written.",
      "The horizontal component is balanced by A_x because the roller at B cannot carry horizontal force.",
      "The force is applied on the beam centerline, so only the vertical component creates a moment about A."
    ]
  }

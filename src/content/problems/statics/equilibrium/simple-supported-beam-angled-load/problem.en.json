      "rhs": "0"
    },
    {
      "id": "sum-force-y",
      "purpose": "sumForceY",
      "scope": { "kind": "body", "bodyId": "beam" },
      "unit": "N",
      "lhs": {
        "terms": [
          {
            "id": "force-y-reaction-ay",
            "sign": "+",
            "unit": "N",
            "quantityId": "reactionAy",
            "mechanicsObjectIds": ["reactionAy"]
          },
          {
            "id": "force-y-reaction-by",
            "sign": "+",
            "unit": "N",
            "quantityId": "reactionBy",
            "mechanicsObjectIds": ["reactionBy"]
          },
          {
            "id": "force-y-load-component",
            "sign": "-",
            "unit": "N",
            "parameterId": "loadMagnitude",
            "componentId": "angledLoadFy",
            "factor": "sin(loadAngle)",
            "mechanicsObjectIds": ["angledLoad", "angledLoadFy"],
            "latex": "F\\sin(\\alpha)"
          }
        ]
      },
      "rhs": "0"
    },
    {
      "id": "result-reaction-ax",
      "purpose": "derivedResult",
      "scope": { "kind": "body", "bodyId": "beam" },
      "unit": "N",
      "lhs": "reactionAx",
      "rhs": "-loadMagnitude*cos(loadAngle)",
      "displayLatex": "A_x = -F\\cos(\\alpha)"
    },
    {
      "id": "result-reaction-by",
      "purpose": "derivedResult",
      "scope": { "kind": "body", "bodyId": "beam" },
      "unit": "N",
      "lhs": "reactionBy",
      "rhs": "loadMagnitude*sin(loadAngle)*loadPosition/beamLength",
      "displayLatex": "B_y = \\frac{F\\sin(\\alpha)\\,a}{L}"
    },
    {
      "id": "result-reaction-ay",
      "purpose": "derivedResult",
      "scope": { "kind": "body", "bodyId": "beam" },
      "unit": "N",
      "lhs": "reactionAy",
      "rhs": "loadMagnitude*sin(loadAngle)*(beamLength-loadPosition)/beamLength",
      "displayLatex": "A_y = \\frac{F\\sin(\\alpha)(L-a)}{L}"
    }

{
  "eyebrow": "Guided explanation",
  "title": "Support reactions",
  "assumptions": [
    "Beam self-weight is neglected.",
    "Supports are ideal: A is a pin and B is a roller.",
    "Positive y is upward and counterclockwise moments are positive."
  ],
  "equations": [
    {
      "id": "sum-force-x",
      "title": "Horizontal force equilibrium",
      "explanation": [
        {
          "type": "paragraph",
          "text": "No external horizontal load is applied, so the horizontal pin reaction is zero."
        }
      ]
    },
    {
      "id": "sum-moment-a",
      "title": "Moment equilibrium about A",
      "explanation": [
        {
          "type": "paragraph",
          "text": "Taking moments about A eliminates $A_x$ and $A_y$, because their lines of action pass through point A."
        }
      ]
    },
    {
      "id": "sum-force-y",
      "title": "Vertical force equilibrium",
      "explanation": [
        {
          "type": "paragraph",
          "text": "After $B_y$ is known, vertical force equilibrium gives the remaining vertical reaction at A."
        }
      ]
    }
  ],
  "steps": [
    {
      "id": "identify-unknowns",
      "title": "1. Identify unknown reactions",
      "body": [
        {
          "type": "paragraph",
          "text": "Support A is a pin, so it can provide $A_x$ and $A_y$. Support B is a roller, so it provides only $B_y$."
        }
      ],
      "canvasState": {
        "visibleObjects": [
          "supportA",
          "supportB",
          "pointLoad",
          "dimensionAtoLoad",
          "dimensionLoadToB",
          "centerLoad"
        ]
      }
    },
    {
      "id": "free-body",
      "title": "2. Replace supports with reaction forces",
      "body": [
        {
          "type": "paragraph",
          "text": "The beam is isolated. The downward load $F$ acts at midspan:"
        },
        {
          "type": "math",
          "latex": "x_F = \\frac{L}{2}"
        },
        {
          "type": "paragraph",
          "text": "The supports are replaced by their reaction components."
        }
      ],
      "canvasState": {
        "visibleObjects": [
          "reactionAx",
          "reactionAy",
          "reactionBy",
          "pointLoad",
          "centerLoad"
        ]
      }
    },
    {
      "id": "equilibrium-x",
      "title": "3. Apply horizontal equilibrium",
      "body": [
        {
          "type": "paragraph",
          "text": "There are no applied horizontal forces, so the pin has no horizontal reaction."
        }
      ],
      "equationIds": [
        "sum-force-x"
      ],
      "canvasState": {
        "visibleObjects": [
          "reactionAy",
          "reactionBy",
          "centerLoad"
        ]
      }
    },
    {
      "id": "moment-a",
      "title": "4. Take moments about A",
      "body": [
        {
          "type": "paragraph",
          "text": "The moment arm for $B_y$ is:"
        },
        {
          "type": "math",
          "latex": "L"
        },
        {
          "type": "paragraph",
          "text": "The moment arm for the load is:"
        },
        {
          "type": "math",
          "latex": "\\frac{L}{2}"
        }
      ],
      "equationIds": [
        "sum-moment-a"
      ],
      "canvasState": {
        "visibleObjects": [
          "reactionAy",
          "reactionBy",
          "dimensionAtoLoad",
          "dimensionLoadToB",
          "centerLoad"
        ]
      }
    },
    {
      "id": "equilibrium-y",
      "title": "5. Apply vertical equilibrium",
      "body": [
        {
          "type": "paragraph",
          "text": "The upward reactions must balance the downward point load."
        }
      ],
      "equationIds": [
        "sum-force-y"
      ],
      "canvasState": {
        "visibleObjects": [
          "reactionAy",
          "reactionBy",
          "centerLoad"
        ]
      }
    },
    {
      "id": "summary",
      "title": "6. Summarize reactions",
      "body": [
        {
          "type": "paragraph",
          "text": "The final support reactions are listed below."
        },
        {
          "type": "math",
          "latex": "A_x = 0",
          "tone": "result"
        },
        {
          "type": "math",
          "latex": "B_y = \\frac{F}{2}",
          "tone": "result"
        },
        {
          "type": "math",
          "latex": "A_y = \\frac{F}{2}",
          "tone": "result"
        }
      ],
      "canvasState": {
        "visibleObjects": [
          "reactionAy",
          "reactionBy",
          "centerLoad"
        ]
      }
    }
  ]
}
